# dist_cluster — Master Node Image
#
# Provides: Python 3 + numpy, OpenSSH client, and all cluster scripts
#           so the orchestrator can be run fully inside a container.
#
# Build:
#   docker build -f docker/Dockerfile.master -t dist_cluster_master .
#
# Run (interactive):
#   docker run -it --rm \
#     -v ~/.ssh/id_rsa:/root/.ssh/id_rsa:ro \
#     -v ~/.ssh/id_rsa.pub:/root/.ssh/id_rsa.pub:ro \
#     -e WORKER_NODES="node1 node2" \
#     dist_cluster_master bash
#
# Then inside the container:
#   bash deploy_cluster.sh
#   bash run_cluster.sh

FROM python:3.11-slim

# ── System packages ──────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client \
        iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────────────────────
RUN pip install --no-cache-dir numpy

# ── SSH client hardening ─────────────────────────────────────────────────────
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh \
    # Disable strict host key checking inside the cluster VPN; workers are
    # ephemeral containers so their host keys change on each start.
    && printf 'Host *\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n  LogLevel ERROR\n' \
       > /root/.ssh/config \
    && chmod 600 /root/.ssh/config

# ── Project files ────────────────────────────────────────────────────────────
WORKDIR /dist_cluster
COPY . .

CMD ["/bin/bash"]
