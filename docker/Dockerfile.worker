# dist_cluster — Worker Node Image
#
# Provides: Python 3 + numpy (+ optional mlx on Apple Silicon),
#           OpenSSH server so deploy_cluster.sh / run_cluster.sh can
#           SSH in exactly as they do with bare-metal nodes.
#
# Build:
#   docker build -f docker/Dockerfile.worker -t dist_cluster_worker .
#
# Run (single worker on a remote host):
#   docker run -d -p 2222:22 \
#     -e SSH_PUBLIC_KEY="$(cat ~/.ssh/id_rsa.pub)" \
#     --name worker1 dist_cluster_worker

FROM python:3.11-slim

# ── System packages ──────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server \
        iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────────────────────
RUN pip install --no-cache-dir numpy

# ── SSH server configuration ─────────────────────────────────────────────────
RUN mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    # Allow root login with key-based auth only; disable password auth
    && sed -i \
        -e 's/#PermitRootLogin.*/PermitRootLogin prohibit-password/' \
        -e 's/#PubkeyAuthentication.*/PubkeyAuthentication yes/' \
        -e 's/#PasswordAuthentication.*/PasswordAuthentication no/' \
        -e 's/#ChallengeResponseAuthentication.*/ChallengeResponseAuthentication no/' \
        /etc/ssh/sshd_config

# ── Project source ───────────────────────────────────────────────────────────
COPY src/ /app/

WORKDIR /app

# ── Entrypoint ───────────────────────────────────────────────────────────────
COPY docker/entrypoint-worker.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22

ENTRYPOINT ["/entrypoint.sh"]
